// generated by scripts/gen-bundled-presets.py — edit the script, not this file.
// Samples: LMMS sample library (GPL-2.0-or-later), see data/samples/CREDITS.md.

<control>
label_cc1=Tone
set_cc1=127
label_cc7=Volume
set_cc7=100

<global>
loop_mode=one_shot
ampeg_attack=0.001 ampeg_sustain=100 ampeg_release=0.05
fil_type=lpf_2p cutoff=500
cutoff_oncc1=6000 volume_oncc7=6

<region> sample=../../samples/drums/shaker01.ogg key=60 pitch_keytrack=0
<region> sample=../../samples/drums/shaker02.ogg key=61 pitch_keytrack=0
<region> sample=../../samples/drums/shaker03.ogg key=62 pitch_keytrack=0
<region> sample=../../samples/drums/wood01.ogg key=63 pitch_keytrack=0
<region> sample=../../samples/drums/clav01.ogg key=64 pitch_keytrack=0
<region> sample=../../samples/drums/clav02.ogg key=65 pitch_keytrack=0
<region> sample=../../samples/drums/zap01.ogg key=66 pitch_keytrack=0
<region> sample=../../samples/drums/zap02.ogg key=67 pitch_keytrack=0
<region> sample=../../samples/drums/zap03.ogg key=68 pitch_keytrack=0
