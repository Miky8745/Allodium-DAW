<control>
label_cc1=Brightness
set_cc1=110
label_cc2=Resonance
set_cc2=0
label_cc3=Attack
set_cc3=0
label_cc4=Release
set_cc4=25

<global>
ampeg_attack=0.25 ampeg_decay=1 ampeg_sustain=100 ampeg_release=1
fil_type=lpf_2p cutoff=700
cutoff_oncc1=5400 resonance_oncc2=14 ampeg_attack_oncc3=1.5 ampeg_release_oncc4=2.5

<group> seq_length=2
<region> sample=../../samples/stringsnpads/space_strings01.ogg pitch_keycenter=36 tune=-2 seq_position=1
<region> sample=../../samples/stringsnpads/space_strings02.ogg pitch_keycenter=36 tune=-2 seq_position=2
