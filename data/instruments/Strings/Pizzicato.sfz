// Pizzicato — Bloom starter preset. Samples: LMMS sample library (GPL-2.0+).
<control>
label_cc1=Brightness
label_cc4=Release
set_cc1=110
set_cc4=20

<global>
ampeg_attack=0.001 ampeg_decay=0.6 ampeg_sustain=0 ampeg_release=0.2
fil_type=lpf_2p cutoff=700
cutoff_oncc1=5400
ampeg_release_oncc4=1

<region> sample=../../samples/instruments/violin_pizzicato01.ogg pitch_keycenter=67
