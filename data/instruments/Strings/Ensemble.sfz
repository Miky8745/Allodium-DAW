// Ensemble — Bloom starter preset: two layered string samples.
// Samples: LMMS sample library (GPL-2.0+).
<control>
label_cc1=Brightness
label_cc3=Attack
label_cc4=Release
label_cc6=Volume
set_cc1=90
set_cc3=40
set_cc4=50
set_cc6=0

<global>
ampeg_attack=0.06 ampeg_decay=0.6 ampeg_sustain=90 ampeg_release=0.25
fil_type=lpf_2p cutoff=450
cutoff_oncc1=5400
ampeg_attack_oncc3=1
ampeg_release_oncc4=2.5
volume_oncc6=4

<region> sample=../../samples/stringsnpads/strings01.ogg pitch_keycenter=60
<region> sample=../../samples/stringsnpads/synth_string01.ogg pitch_keycenter=60 volume=-9
