// generated by scripts/gen-bundled-presets.py — edit the script, not this file.
// Samples: LMMS sample library (GPL-2.0-or-later), see data/samples/CREDITS.md.

<control>
label_cc1=Brightness
set_cc1=75
label_cc2=Resonance
set_cc2=30
label_cc3=Attack
set_cc3=0
label_cc4=Release
set_cc4=15
label_cc5=Env Depth
set_cc5=50

<global>
loop_mode=loop_continuous
ampeg_attack=0.005 ampeg_decay=0.3 ampeg_sustain=80 ampeg_release=0.08
fil_type=lpf_2p cutoff=250 resonance=2
fileg_attack=0.01 fileg_decay=0.5
cutoff_oncc1=6000 resonance_oncc2=14 ampeg_attack_oncc3=1 ampeg_release_oncc4=1.5 fileg_depth_oncc5=4800

<region> sample=../../samples/shapes/fat_analog.wav pitch_keycenter=24 tune=6 pan=-60 volume=-5
<region> sample=../../samples/shapes/fat_analog.wav pitch_keycenter=24 tune=20 pan=0 volume=-5
<region> sample=../../samples/shapes/fat_analog.wav pitch_keycenter=24 tune=34 pan=60 volume=-5
