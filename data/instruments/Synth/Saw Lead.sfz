// Saw Lead — Bloom starter preset: a looped single-cycle saw wave.
// Samples: LMMS sample library (GPL-2.0+).
<control>
label_cc1=Brightness
label_cc2=Resonance
label_cc3=Attack
label_cc4=Release
label_cc5=Env Depth
set_cc1=70
set_cc2=30
set_cc3=0
set_cc4=20
set_cc5=50

<global>
loop_mode=loop_continuous
ampeg_attack=0.005 ampeg_decay=0.3 ampeg_sustain=80 ampeg_release=0.08
fil_type=lpf_2p cutoff=250 resonance=2
fileg_attack=0.01 fileg_decay=0.5
cutoff_oncc1=6000
resonance_oncc2=14
ampeg_attack_oncc3=1
ampeg_release_oncc4=1.5
fileg_depth_oncc5=4800

// saw1.flac is one 221-frame cycle at 96 kHz ≈ 434.4 Hz (A4 −22 cents).
<region> sample=../../samples/waveforms/saw1.flac pitch_keycenter=69 tune=22
