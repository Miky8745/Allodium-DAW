<region> sample=../../samples/drums/clap02.ogg key=63
<region> sample=../../samples/drums/snare04.ogg key=64
<region> sample=../../samples/drums/tom04.ogg key=65
<region> sample=../../samples/drums/hihat_closed03.ogg key=66
<region> sample=../../samples/drums/tom03.ogg key=67
<region> sample=../../samples/drums/hihat_foot_pedal01.ogg key=68
<region> sample=../../samples/drums/tom02.ogg key=69
<region> sample=../../samples/drums/hihat_opened02.ogg key=70
<region> sample=../../samples/drums/crash02.ogg key=71
