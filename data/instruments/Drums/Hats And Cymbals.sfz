<region> sample=../../samples/drums/hihat_opened01.ogg key=66 pitch_keytrack=0
<region> sample=../../samples/drums/hihat_opened02.ogg key=67 pitch_keytrack=0
<region> sample=../../samples/drums/hihat_opened03.ogg key=68 pitch_keytrack=0
