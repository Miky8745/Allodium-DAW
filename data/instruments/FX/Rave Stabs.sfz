<control>
label_cc1=Tone
set_cc1=127
label_cc7=Volume
set_cc7=100

<global>
loop_mode=one_shot
ampeg_attack=0.001 ampeg_sustain=100 ampeg_release=0.05
fil_type=lpf_2p cutoff=500
cutoff_oncc1=6000 volume_oncc7=6

<region> sample=../../samples/basses/rave_bass01.ogg key=60 pitch_keytrack=0
