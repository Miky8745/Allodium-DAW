<region> sample=../../samples/basses/techno_synth01.ogg key=65 pitch_keytrack=0
<region> sample=../../samples/basses/bass_acid01.ogg key=66 pitch_keytrack=0
<region> sample=../../samples/stringsnpads/rave_choir01.ogg key=67 pitch_keytrack=0
