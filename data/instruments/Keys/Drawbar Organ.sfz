// Drawbar Organ — Bloom starter preset. Samples: LMMS sample library (GPL-2.0+).
<control>
label_cc1=Brightness
label_cc2=Resonance
label_cc4=Release
set_cc1=100
set_cc2=0
set_cc4=10

<global>
ampeg_attack=0.01 ampeg_decay=0 ampeg_sustain=100 ampeg_release=0.08
fil_type=lpf_2p cutoff=500
cutoff_oncc1=6000
resonance_oncc2=14
ampeg_release_oncc4=1

<region> sample=../../samples/instruments/e_organ01.ogg pitch_keycenter=36
