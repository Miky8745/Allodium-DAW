<control>
label_cc1=Brightness
set_cc1=110
label_cc2=Resonance
set_cc2=0
label_cc4=Decay
set_cc4=40
label_cc5=Release
set_cc5=20

<global>
ampeg_attack=0.001 ampeg_decay=4 ampeg_sustain=0 ampeg_release=0.3
fil_type=lpf_2p cutoff=1400
cutoff_oncc1=5400 resonance_oncc2=14 ampeg_decay_oncc4=4 ampeg_release_oncc5=2

<region> sample=../../samples/instruments/piano02.ogg pitch_keycenter=48 tune=-8 lokey=0 hikey=54
<region> sample=../../samples/instruments/piano01.ogg pitch_keycenter=60 tune=-7 lokey=55 hikey=127
