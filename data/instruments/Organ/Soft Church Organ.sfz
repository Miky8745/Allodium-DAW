<control>
label_cc1=Brightness
set_cc1=110
label_cc2=Resonance
set_cc2=0
label_cc3=Attack
set_cc3=0
label_cc4=Release
set_cc4=25

<global>
ampeg_attack=0.08 ampeg_decay=1 ampeg_sustain=100 ampeg_release=0.6
fil_type=lpf_2p cutoff=600
cutoff_oncc1=5400 resonance_oncc2=14 ampeg_attack_oncc3=1.5 ampeg_release_oncc4=2.5

<region> sample=../../samples/instruments/church_organ04.ogg pitch_keycenter=45 tune=2 lokey=0 hikey=50
<region> sample=../../samples/instruments/church_organ03.ogg pitch_keycenter=57 tune=2 lokey=51 hikey=127
