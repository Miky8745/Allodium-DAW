// Trumpet — Bloom starter preset. Samples: LMMS sample library (GPL-2.0+).
<control>
label_cc1=Brightness
label_cc3=Attack
label_cc4=Release
set_cc1=110
set_cc3=10
set_cc4=20

<global>
ampeg_attack=0.02 ampeg_decay=0.4 ampeg_sustain=80 ampeg_release=0.12
fil_type=lpf_2p cutoff=600
cutoff_oncc1=5400
ampeg_attack_oncc3=0.6
ampeg_release_oncc4=1.2

<region> sample=../../samples/instruments/trumpet01.ogg pitch_keycenter=69
