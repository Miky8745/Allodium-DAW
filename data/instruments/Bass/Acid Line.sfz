// Acid Line — Bloom starter preset. Samples: LMMS sample library (GPL-2.0+).
<control>
label_cc1=Cutoff
label_cc2=Resonance
label_cc4=Decay
label_cc5=Env Depth
set_cc1=40
set_cc2=90
set_cc4=30
set_cc5=80

<global>
ampeg_attack=0.001 ampeg_decay=0.3 ampeg_sustain=60 ampeg_release=0.05
fil_type=lpf_2p cutoff=100 resonance=6
fileg_attack=0.002 fileg_decay=0.18
cutoff_oncc1=4200
resonance_oncc2=16
fileg_decay_oncc4=0.8
fileg_depth_oncc5=5400

<region> sample=../../samples/basses/synth_acid01.ogg pitch_keycenter=36
