<control>
label_cc1=Cutoff
set_cc1=60
label_cc2=Resonance
set_cc2=35
label_cc4=Decay
set_cc4=30
label_cc5=Env Depth
set_cc5=75

<global>
loop_mode=loop_continuous
ampeg_attack=0.001 ampeg_decay=0.3 ampeg_sustain=0 ampeg_release=0.2
fil_type=lpf_2p cutoff=140 resonance=3
fileg_attack=0.001 fileg_decay=0.18
cutoff_oncc1=4800 resonance_oncc2=14 ampeg_decay_oncc4=1.5 fileg_depth_oncc5=6000

<region> sample=../../samples/waveforms/w2_invsineabs.flac pitch_keycenter=15 tune=-49
