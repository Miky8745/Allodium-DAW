// Analog Pad — Bloom starter preset. Samples: LMMS sample library (GPL-2.0+).
<control>
label_cc1=Brightness
label_cc2=Resonance
label_cc3=Attack
label_cc4=Release
label_cc5=Swell
set_cc1=80
set_cc2=20
set_cc3=50
set_cc4=60
set_cc5=40

<global>
ampeg_attack=0.05 ampeg_decay=1 ampeg_sustain=85 ampeg_release=0.3
fil_type=lpf_2p cutoff=300 resonance=2
fileg_attack=0.6 fileg_decay=1.8
cutoff_oncc1=6000
resonance_oncc2=12
ampeg_attack_oncc3=1.5
ampeg_release_oncc4=3
fileg_depth_oncc5=3600

<region> sample=../../samples/stringsnpads/analog_pad01.ogg pitch_keycenter=72
