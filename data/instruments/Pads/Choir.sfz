// Choir — Bloom starter preset. Samples: LMMS sample library (GPL-2.0+).
<control>
label_cc1=Brightness
label_cc3=Attack
label_cc4=Release
set_cc1=100
set_cc3=40
set_cc4=60

<global>
ampeg_attack=0.08 ampeg_decay=0.5 ampeg_sustain=90 ampeg_release=0.3
fil_type=lpf_2p cutoff=500
cutoff_oncc1=5400
ampeg_attack_oncc3=1.2
ampeg_release_oncc4=2.5

<region> sample=../../samples/stringsnpads/chorus01.ogg pitch_keycenter=72
