// generated by scripts/gen-bundled-presets.py — edit the script, not this file.
// Samples: LMMS sample library (GPL-2.0-or-later), see data/samples/CREDITS.md.

<control>
label_cc1=Brightness
set_cc1=85
label_cc2=Resonance
set_cc2=20
label_cc3=Attack
set_cc3=30
label_cc4=Release
set_cc4=40
label_cc5=Swell
set_cc5=40

<global>
loop_mode=loop_continuous
ampeg_attack=0.3 ampeg_decay=1.5 ampeg_sustain=85 ampeg_release=0.6
fil_type=lpf_2p cutoff=180 resonance=1
fileg_attack=1 fileg_decay=2
cutoff_oncc1=5400 resonance_oncc2=12 ampeg_attack_oncc3=2.5 ampeg_release_oncc4=3 fileg_depth_oncc5=3600

<region> sample=../../samples/shapes/bunglist8.wav pitch_keycenter=48 tune=-10 pan=-50 volume=-3
<region> sample=../../samples/shapes/bunglist8.wav pitch_keycenter=48 tune=8 pan=50 volume=-3
